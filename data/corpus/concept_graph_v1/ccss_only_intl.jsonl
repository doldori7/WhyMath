{"node_id": "US:HSN-Q.A.1", "ccss_code": "HSN-Q.A.1", "scope": "\ud55c\uad6d\ubbf8\uc218\ub85d\u00b7CCSS\uc804\uc6a9(\uad6d\uc81c\ud2b8\ub799)", "kr_adjacent_area": "\uace0\uad50 \uc2e4\uc6a9\uc218\ud559\u00b7\uce21\uc815", "kr_interpretation": "\ub2e8\uc704\ub97c \uc774\uc6a9\ud574 \ubb38\uc81c\ub97c \uc774\ud574\ud558\uace0 \uc5ec\ub7ec \ub2e8\uacc4 \ud480\uc774\ub97c \uc774\ub048\ub2e4.", "kr_absence_reason": "\ud55c\uad6d\uc740 \ub2e8\uc704\u00b7\uc591\u00b7\uc815\ud655\ub3c4(\uc720\ud6a8\uc22b\uc790)\ub97c \uce21\uc815\u00b7\ud65c\uc6a9 \ub9e5\ub77d\uc5d0 \ub179\uc5ec \ub2e4\ub8e8\uba70 \ubcc4\ub3c4 \uc131\ucde8\uae30\uc900\uc774 \uc5c6\uc74c. \ubbf8\uad6d\uc740 \ubaa8\ub378\ub9c1 \ud45c\uc900\uc73c\ub85c \uba85\uc2dc.", "_redacted_fields": ["ccss_statement_en"]}
