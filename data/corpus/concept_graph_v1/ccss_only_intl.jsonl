{"node_id": "US:K.CC.A.1", "ccss_code": "K.CC.A.1", "scope": "\ud55c\uad6d\ubbf8\uc218\ub85d\u00b7CCSS\uc804\uc6a9(\uad6d\uc81c\ud2b8\ub799)", "kr_adjacent_area": "\ucd08\ub4f1 \uc218\uc640 \uc5f0\uc0b0(\ucde8\ud559 \uc804 \uc138\uae30)", "kr_interpretation": "1\uc529, \uadf8\ub9ac\uace0 10\uc529 \uc138\uc5b4 100\uae4c\uc9c0 \uc13c\ub2e4.", "kr_absence_reason": "\ud55c\uad6d 2022 \uad50\uc721\uacfc\uc815\uc740 1\ud559\ub144\ubd80\ud130 \uc218 \uc138\uae30\ub97c \ub2e4\ub8e8\uba70 \uc720\uce58\uc6d0 \ub2e8\uacc4 \ubcc4\ub3c4 \uc131\ucde8\uae30\uc900\uc774 \uc5c6\uc74c. \ubbf8\uad6d\uc740 K(\uc720\uce58\uc6d0)\uc5d0\uc11c \uba85\uc2dc \ud45c\uc900\uc73c\ub85c \ub460.", "_redacted_fields": ["ccss_statement_en"]}
{"node_id": "US:K.CC.A.2", "ccss_code": "K.CC.A.2", "scope": "\ud55c\uad6d\ubbf8\uc218\ub85d\u00b7CCSS\uc804\uc6a9(\uad6d\uc81c\ud2b8\ub799)", "kr_adjacent_area": "\ucd08\ub4f1 \uc218\uc640 \uc5f0\uc0b0(\ucde8\ud559 \uc804 \uc138\uae30)", "kr_interpretation": "1\uc774 \uc544\ub2c8\ub77c \uc8fc\uc5b4\uc9c4 \uc218\uc5d0\uc11c \uc2dc\uc791\ud558\uc5ec \uc774\uc5b4 \uc13c\ub2e4.", "kr_absence_reason": "\ud55c\uad6d 2022 \uad50\uc721\uacfc\uc815\uc740 1\ud559\ub144\ubd80\ud130 \uc218 \uc138\uae30\ub97c \ub2e4\ub8e8\uba70 \uc720\uce58\uc6d0 \ub2e8\uacc4 \ubcc4\ub3c4 \uc131\ucde8\uae30\uc900\uc774 \uc5c6\uc74c. \ubbf8\uad6d\uc740 K(\uc720\uce58\uc6d0)\uc5d0\uc11c \uba85\uc2dc \ud45c\uc900\uc73c\ub85c \ub460.", "_redacted_fields": ["ccss_statement_en"]}
{"node_id": "US:K.CC.A.3", "ccss_code": "K.CC.A.3", "scope": "\ud55c\uad6d\ubbf8\uc218\ub85d\u00b7CCSS\uc804\uc6a9(\uad6d\uc81c\ud2b8\ub799)", "kr_adjacent_area": "\ucd08\ub4f1 \uc218\uc640 \uc5f0\uc0b0(\ucde8\ud559 \uc804 \uc138\uae30)", "kr_interpretation": "0\ubd80\ud130 20\uae4c\uc9c0\uc758 \uc218\ub97c \uc4f0\uace0, \ubb3c\uccb4\uc758 \uac1c\uc218\ub97c \uc22b\uc790\ub85c \ub098\ud0c0\ub0b8\ub2e4.", "kr_absence_reason": "\ud55c\uad6d 2022 \uad50\uc721\uacfc\uc815\uc740 1\ud559\ub144\ubd80\ud130 \uc218 \uc138\uae30\ub97c \ub2e4\ub8e8\uba70 \uc720\uce58\uc6d0 \ub2e8\uacc4 \ubcc4\ub3c4 \uc131\ucde8\uae30\uc900\uc774 \uc5c6\uc74c. \ubbf8\uad6d\uc740 K(\uc720\uce58\uc6d0)\uc5d0\uc11c \uba85\uc2dc \ud45c\uc900\uc73c\ub85c \ub460.", "_redacted_fields": ["ccss_statement_en"]}
{"node_id": "US:K.CC.B.4", "ccss_code": "K.CC.B.4", "scope": "\ud55c\uad6d\ubbf8\uc218\ub85d\u00b7CCSS\uc804\uc6a9(\uad6d\uc81c\ud2b8\ub799)", "kr_adjacent_area": "\ucd08\ub4f1 \uc218\uc640 \uc5f0\uc0b0(\ucde8\ud559 \uc804 \uc138\uae30)", "kr_interpretation": "\uc218\uc640 \uc591\uc758 \uad00\uacc4\ub97c \uc774\ud574\ud558\uace0, \uc138\uae30\ub97c \uae30\uc218(\ub9c8\uc9c0\ub9c9\uc5d0 \uc13c \uc218\uac00 \uc804\uccb4 \uac1c\uc218)\uc640 \uc5f0\uacb0\ud55c\ub2e4.", "kr_absence_reason": "\ud55c\uad6d 2022 \uad50\uc721\uacfc\uc815\uc740 1\ud559\ub144\ubd80\ud130 \uc218 \uc138\uae30\ub97c \ub2e4\ub8e8\uba70 \uc720\uce58\uc6d0 \ub2e8\uacc4 \ubcc4\ub3c4 \uc131\ucde8\uae30\uc900\uc774 \uc5c6\uc74c. \ubbf8\uad6d\uc740 K(\uc720\uce58\uc6d0)\uc5d0\uc11c \uba85\uc2dc \ud45c\uc900\uc73c\ub85c \ub460.", "_redacted_fields": ["ccss_statement_en"]}
