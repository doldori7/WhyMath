{"formula_id": "formula.multiplication.square-of-sum", "name_ko": "합의 제곱", "family": "곱셈공식", "latex": "(a+b)^2 = a^2 + 2ab + b^2", "dsl": "(a + b)**2 == a**2 + 2*a*b + b**2", "standard_codes": ["9수02-08"], "constraints": [], "mnemonic": null}
