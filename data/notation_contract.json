    {"id": "displaylines_wrapper_unwrapped", "latex": "\\displaylines{a+b}", "plain": "a+b"},
    {"id": "environment_stripped", "latex": "\\begin{aligned}x=1\\end{aligned}", "plain": "x=1"}
