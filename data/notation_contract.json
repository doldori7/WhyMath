  "equivalence_cases": [
    {"id": "distributive", "a": "2*(x+1)", "b": "2*x+2", "equivalent": true},
    {"id": "binomial_expand", "a": "(x+1)^2", "b": "x^2+2*x+1", "equivalent": true},
    {"id": "freshman_dream", "a": "(a+b)^2", "b": "a^2+b^2", "equivalent": false},
