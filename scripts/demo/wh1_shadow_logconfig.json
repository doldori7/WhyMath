{
  "_설명": "WH-1 shadow record 캡처용 uvicorn --log-config (dictConfig JSON). uvicorn 기본 로깅은 자기 로거(uvicorn/uvicorn.error/uvicorn.access)만 구성하고 root를 안 건드려, 앱 INFO 로그(record 라인)는 logging.lastResort(WARNING 이상)에서 탈락한다(2026-07-17 실측 — uvicorn 0.51 LOGGING_CONFIG 확인). 이 설정은 uvicorn 기본을 유지하면서 whymath.harness.wh1_shadow.record 로거만 FileHandler로 분리 캡처한다. filename이 상대경로라 uvicorn 기동 cwd(src\\backend) 기준으로 wh1_shadow_records.log가 생긴다 — 포맷은 %(message)s뿐이라 파일은 순수 JSONL(wh1_shadow_harvest 직접 입력 가능).",
  "version": 1,
  "disable_existing_loggers": false,
  "formatters": {
    "default": {
      "()": "uvicorn.logging.DefaultFormatter",
      "fmt": "%(levelprefix)s %(message)s",
      "use_colors": null
    },
    "access": {
      "()": "uvicorn.logging.AccessFormatter",
      "fmt": "%(levelprefix)s %(client_addr)s - \"%(request_line)s\" %(status_code)s"
    },
    "record_json": {
      "format": "%(message)s"
    }
  },
  "handlers": {
    "default": {
      "formatter": "default",
      "class": "logging.StreamHandler",
      "stream": "ext://sys.stderr"
    },
    "access": {
      "formatter": "access",
      "class": "logging.StreamHandler",
      "stream": "ext://sys.stdout"
    },
    "wh1_record_file": {
      "class": "logging.FileHandler",
      "filename": "wh1_shadow_records.log",
      "encoding": "utf-8",
      "delay": true,
      "formatter": "record_json"
    }
  },
  "loggers": {
    "uvicorn": { "handlers": ["default"], "level": "INFO", "propagate": false },
    "uvicorn.error": { "level": "INFO" },
    "uvicorn.access": { "handlers": ["access"], "level": "INFO", "propagate": false },
    "whymath.harness.wh1_shadow.record": {
      "handlers": ["wh1_record_file"],
      "level": "INFO",
      "propagate": false
    }
  }
}
